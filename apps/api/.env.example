# Database (MySQL / MariaDB)
DATABASE_URL="mysql://root@localhost:3306/otiko"

# JWT
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=4000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# Email (Gmail SMTP: use a Google App Password, not your account password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-address@gmail.com"
SMTP_PASS="your-16-character-google-app-password"
EMAIL_FROM="OTIKO <your-address@gmail.com>"
# Optional fallback provider
RESEND_API_KEY=""

# M-Pesa (fill in when integrating)
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE="174379"
MPESA_CALLBACK_URL="http://localhost:4000/api/payments/webhook"
MPESA_ENVIRONMENT="sandbox"
